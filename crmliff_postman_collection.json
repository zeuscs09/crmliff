		{
			"name": "Create Store",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Store created successfully\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('message');",
							"    if (jsonData.message && jsonData.message.success) {",
							"        pm.expect(jsonData.message).to.have.property('data');",
							"        pm.expect(jsonData.message.data).to.have.property('visit_id');",
							"        pm.expect(jsonData.message.data).to.have.property('store_id');",
							"        ",
							"        // Store values for next requests",
							"        pm.globals.set('visit_id', jsonData.message.data.visit_id);",
							"        pm.globals.set('store_id', jsonData.message.data.store_id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
