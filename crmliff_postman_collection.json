		{
			"name": "Create Store",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Store created successfully\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('message');",
							"    if (jsonData.message && jsonData.message.success) {",
							"        pm.expect(jsonData.message).to.have.property('data');",
							"        pm.expect(jsonData.message.data).to.have.property('visit_id');",
							"        pm.expect(jsonData.message.data).to.have.property('store_id');",
							"        ",
							"        // Store values for next requests",
							"        pm.globals.set('visit_id', jsonData.message.data.visit_id);",
							"        pm.globals.set('store_id', jsonData.message.data.store_id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"agent_code\": \"S001\",\n    \"location_lat\": 13.7563,\n    \"location_lng\": 100.5018,\n    \"address\": \"123 Test Street, Bangkok\",\n    \"store_type\": \"FOOD\",\n    \"store_name\": \"ร้านทดสอบ Postman\",\n    \"store_description\": \"ร้านทดสอบสำหรับ API testing\",\n    \"contact_name\": \"คุณทดสอบ\",\n    \"contact_phone\": \"+66812345678\",\n    \"cover_image\": \"data:image/jpeg;base64,\",\n    \"photos\": [\n        {\n            \"image\": \"data:image/jpeg;base64,\",\n            \"caption\": \"รูปหน้าร้าน\"\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/crmliff.api.liff_api.create_store",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"crmliff.api.liff_api.create_store"
					]
				}
			},
			"response": []
		},
		{
			"name": "Check-in Store",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Ensure we have a store_id from previous Create Store request",
							"if (!pm.globals.get('store_id')) {",
							"    console.log('Warning: No store_id found. Please run \"Create Store\" first.');",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Check-in successful\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('message');",
							"    if (jsonData.message && jsonData.message.success) {",
							"        pm.expect(jsonData.message).to.have.property('data');",
							"        pm.expect(jsonData.message.data).to.have.property('visit_id');",
							"        pm.expect(jsonData.message.data).to.have.property('store_id');",
							"        pm.expect(jsonData.message.data).to.have.property('store_name');",
							"        console.log('Check-in successful for store:', jsonData.message.data.store_name);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"agent_code\": \"S001\",\n    \"store_id\": \"{{store_id}}\",\n    \"location_lat\": 13.7565,\n    \"location_lng\": 100.5020,\n    \"photos\": [\n        {\n            \"image\": \"data:image/jpeg;base64,\",\n            \"caption\": \"การเช็คอิน\"\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/method/crmliff.api.liff_api.checkin_store",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"crmliff.api.liff_api.checkin_store"
					]
				}
			},
			"response": []
		},
