    {
      "name": "Standard REST (token)",
      "description": "Frappe Standard REST: ใช้ Authorization header: token {{api_key}}:{{api_secret}}",
      "item": [
        {
          "name": "CLIFF Store",
          "item": [
            {
              "name": "List Stores",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "token {{api_key}}:{{api_secret}}"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/resource/CLIFF%20Store?limit_page_length={{page_size}}&limit_start={{page_start}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "resource", "CLIFF Store"],
                  "query": [
                    {"key": "limit_page_length", "value": "{{page_size}}"},
                    {"key": "limit_start", "value": "{{page_start}}"},
                    {"key": "fields", "value": "[\"name\",\"store_name\",\"store_type\",\"store_description\",\"contact_name\",\"contact_phone\",\"location_lat\",\"location_lng\",\"address\",\"cover_image\",\"total_visits\",\"modified\"]"},
                    {"key": "filters", "value": "[[\"created_by_agent\",\"=\",\"{{agent_code}}\"]]"}
                  ]
                },
                "description": "รายการ CLIFF Store (filter created_by_agent) พร้อม pagination: limit_page_length=&limit_start="
              },
              "response": []
            },
            {
              "name": "Get Store",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "token {{api_key}}:{{api_secret}}"}
                ],
                "url": {
