					]
				},
				"url": {
					"raw": "{{base_url}}/api/method/crmliff.api.liff_api.link_line_account",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"crmliff.api.liff_api.link_line_account"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Agent Info by LINE UID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/method/crmliff.api.liff_api.get_agent_info?line_uid=U123456789abcdef",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"method",
						"crmliff.api.liff_api.get_agent_info"
					],
